# =============================================================
# Dockerfile de PRODUCCIÓN para cualquiera de las 3 apps Vite
# (frontend, storefront, landing). Un solo Dockerfile parametrizado
# con ARG APP_DIR en vez de uno por app, para no repetir 3 veces
# el mismo Dockerfile.
#
# OJO: el docker/node/Dockerfile de DESARROLLO tiene
# `COPY frontend/package*.json ./` fijo a "frontend" sin importar
# qué app lo use — funciona en dev solo porque el bind mount pisa
# todo igual. Ese atajo no sirve para producción (acá no hay bind
# mount, lo que se copia en el build ES la app final), así que este
# Dockerfile sí usa el ARG correctamente para cada app.
#
# Build (ejemplo para storefront):
#   docker build -f docker/node/Dockerfile.prod \
#     --build-arg APP_DIR=storefront \
#     --build-arg VITE_API_URL=https://api.colmerzia.com/api \
#     -t colmerzia-storefront .
# =============================================================

ARG APP_DIR

# ---- Etapa 1: build estático con Vite ----
FROM node:22 AS build

ARG APP_DIR
ARG VITE_API_URL
ARG VITE_ADMIN_URL

WORKDIR /app

COPY ${APP_DIR}/package*.json ./
RUN npm install

COPY ${APP_DIR}/ .

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_ADMIN_URL=${VITE_ADMIN_URL}

RUN npm run build


# ---- Etapa 2: servir el build con nginx ----
FROM nginx:1.28-alpine AS serve

COPY docker/node/spa.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
