ARG APP_DIR

FROM node:22 AS build

ARG APP_DIR
ARG VITE_API_URL
ARG VITE_ADMIN_URL

WORKDIR /app

COPY ${APP_DIR}/package.json ${APP_DIR}/package-lock.json ./

# npm ci usa exactamente el lockfile y no modifica dependencias durante el build.
RUN npm ci --ignore-scripts

COPY ${APP_DIR}/ ./

# Solo deben pasar aquí valores públicos Vite (nunca secretos).
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_ADMIN_URL=${VITE_ADMIN_URL}

RUN npm run build

FROM nginx:1.28-alpine AS serve

COPY docker/node/spa.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
