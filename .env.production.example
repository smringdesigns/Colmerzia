# =============================================================
# Variables de entorno de PRODUCCIÓN.
#
# Copiá este archivo a .env.production y completá los valores
# marcados con "CAMBIAR". NUNCA subas .env.production a git (ya
# debería estar en .gitignore junto con los demás .env).
# =============================================================

APP_NAME=Colmerzia
APP_ENV=production
APP_KEY=                          # CAMBIAR: correr `php artisan key:generate --show` y pegar acá
APP_DEBUG=false                   # NUNCA true en producción -- expone stack traces con datos sensibles
APP_URL=https://admin.colmerzia.com

# *.colmerzia.com cubre TODOS los subdominios de tienda actuales y
# futuros -- no hace falta agregar cada tienda nueva acá.
TENANCY_CENTRAL_DOMAINS=colmerzia.com,www.colmerzia.com,admin.colmerzia.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                   # "debug" es muy verboso/lento para producción

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=colmerzia
DB_USERNAME=colmerzia             # CAMBIAR: no reutilices el usuario "postgres" de superusuario
DB_PASSWORD=                      # CAMBIAR: contraseña fuerte, generá una nueva para producción

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true        # obligatorio en https

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local             # ver DEPLOY.md sobre migrar a "s3" más adelante

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# CAMBIAR: proveedor de correo real (Resend, SES, Postmark, etc).
# mailpit (el que usan en dev) NO existe en docker-compose.prod.yml
# a propósito -- es solo una bandeja de pruebas local.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@colmerzia.com"
MAIL_FROM_NAME="${APP_NAME}"

# Solo hace falta si en algún momento pasan FILESYSTEM_DISK a "s3".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
