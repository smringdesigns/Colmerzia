# Copia este archivo como .env.production en el servidor.
# Nunca lo subas con valores reales al repositorio.

APP_NAME=Colmerzia
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.colmerzia.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=colmerzia
DB_USERNAME=REPLACE_WITH_SECRET_MANAGER_VALUE
DB_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

SANCTUM_STATEFUL_DOMAINS=admin.colmerzia.com
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=colmerzia_

TENANCY_CENTRAL_DOMAINS=colmerzia.com,www.colmerzia.com,admin.colmerzia.com
CORS_ALLOWED_ORIGINS=https://admin.colmerzia.com,https://www.colmerzia.com
FRONTEND_URL=https://admin.colmerzia.com
STOREFRONT_BASE_URL=https://colmerzia.com

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SECRET_MANAGER_VALUE
MAIL_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@colmerzia.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=REPLACE_WITH_SECRET_MANAGER_VALUE
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=REPLACE_WITH_BUCKET
AWS_USE_PATH_STYLE_ENDPOINT=false

SEED_ADMIN_PASSWORD=ONLY_FOR_INITIAL_SEEDING
